# ── LLM: Groq (free at console.groq.com) ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_ID=openai/gpt-oss-20b

# ── VLM + Embeddings + LLM: Gemini (free at aistudio.google.com) ─────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-3-flash-preview
GEMINI_VLM_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# ── Vector DB: Pinecone (free at app.pinecone.io) ─────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=gameengine-doctor

# ── Web Search: Tavily (free at app.tavily.com) ───────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Cache: Upstash Redis (free at console.upstash.com) ────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Observability: LangSmith (free at smith.langchain.com) ────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=gameengine-doctor

# ── App Config ─────────────────────────────────────────────────────────────────
DOCS_PATH=./data/docs
TOP_K=4
CACHE_TTL_SECONDS=3600
